# sway config

set $mod Mod4
set $term foot
set $browser firefox


# === output ===
output eDP-1 {
	resolution 2880x1800@120Hz
	scale 1.3
}


# === general ===
font pango:JetBrains Mono 10

# set cursor theme and size
seat seat0 xcursor_theme Adwaita 26


hide_edge_borders --i3 none
default_border pixel 3
smart_borders on

# === idle ===
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'


exec pipewire

# wob OSD (volume/brightness bar)
exec sh -c '[ -p /tmp/wobpipe ] || mkfifo /tmp/wobpipe; tail -f /tmp/wobpipe | wob'

# autotiling
exec sat 

# notifications
exec mako

exec filen sync documents:tw:Documents

# === input ===
input type:touchpad {
	dwt enabled
	tap enabled
	natural_scroll enabled
	middle_emulation enabled
}
input type:keyboard {
	xkb_options compose:ralt,caps:escape,ctrl:swap_alt_ctl
}
input type:pointer {
	natural_scroll enabled
}

# === window rules ===
for_window [app_id="^foot_float$"] floating enable

# === includes ===
include /etc/sway/config.d/*
include ~/.config/sway/bar.conf
include ~/.config/sway/colors.conf
include ~/.config/sway/keybinds.conf
